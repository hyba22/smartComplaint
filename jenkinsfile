pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 90, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_REGISTRY = 'https://index.docker.io/v1/'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat './mvnw.cmd -B -Pprod compile'
            }
        }

        stage('Unit & Frontend Tests') {
            steps {
                bat './mvnw.cmd -B -Pprod test'
            }
            post {
                always {
                    junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Integration Tests') {
            steps {
                bat './mvnw.cmd -B -Pprod failsafe:integration-test failsafe:verify'
            }
            post {
                always {
                    junit testResults: '**/target/failsafe-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Build & Push Backend') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    bat '''
                        echo %DOCKER_PASSWORD% > docker_password.txt
                        docker login --username %DOCKER_USERNAME% --password-stdin < docker_password.txt
                        del docker_password.txt

                        mvnw.cmd -B -Pprod clean jib:build -DskipTests -Djib.image=%DOCKER_USERNAME%/smartcomplaint:%BUILD_NUMBER%
                    '''
                }
            }
        }

        stage('Build & Push Frontend') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    bat '''
                        echo %DOCKER_PASSWORD% > docker_password.txt
                        docker login --username %DOCKER_USERNAME% --password-stdin < docker_password.txt
                        del docker_password.txt

                        docker build -f src/main/docker/Dockerfile.frontend -t %DOCKER_USERNAME%/smartcomplaint-frontend:%BUILD_NUMBER% .
                        docker push %DOCKER_USERNAME%/smartcomplaint-frontend:%BUILD_NUMBER%
                        docker tag %DOCKER_USERNAME%/smartcomplaint-frontend:%BUILD_NUMBER% %DOCKER_USERNAME%/smartcomplaint-frontend:latest
                        docker push %DOCKER_USERNAME%/smartcomplaint-frontend:latest
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        failure {
            echo 'Pipeline failed, Check the console output and test reports above.'
        }
    }
}
