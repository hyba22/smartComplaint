# syntax=docker/dockerfile:1

# Stage 1: Build the React frontend
FROM node:24-alpine AS builder

WORKDIR /app

# Copy package manifests first for better layer caching
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy build configuration and frontend source
COPY tsconfig.json tsconfig.test.json ./
COPY postcss.config.cjs tailwind.config.cjs ./
COPY eslint.config.ts ./
COPY webpack ./webpack
COPY src/main/webapp ./src/main/webapp

# Build the production static bundle
RUN npm run webapp:build:prod

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Default backend target (override at runtime with -e BACKEND_HOST=... -e BACKEND_PORT=...)
ENV BACKEND_HOST=backend
ENV BACKEND_PORT=8282

# Copy built static files from the builder stage
COPY --from=builder /app/target/classes/static /usr/share/nginx/html

# Copy Nginx config template (envsubst produces /etc/nginx/conf.d/default.conf)
COPY src/main/docker/nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
