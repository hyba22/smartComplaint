<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- Add SUPER_ADMIN authority -->
    <changeSet id="20250517170000-1" author="admin">
        <insert tableName="jhi_authority">
            <column name="name" value="ROLE_SUPER_ADMIN"/>
        </insert>
    </changeSet>
    <!-- Grant ROLE_ADMIN to admin@example.com user -->
    <changeSet id="20250517170000-2" author="admin">
        <sql>
            INSERT INTO jhi_user_authority (user_id, authority_name)
            SELECT id, 'ROLE_ADMIN'
            FROM jhi_user
            WHERE email = 'admin@example.com'
            AND NOT EXISTS (
                SELECT 1 FROM jhi_user_authority
                WHERE user_id = (SELECT id FROM jhi_user WHERE email = 'admin@example.com')
                AND authority_name = 'ROLE_ADMIN'
            );
        </sql>
    </changeSet>
</databaseChangeLog>
